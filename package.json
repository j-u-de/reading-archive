{
  "name": "reading-archive",
  "version": "2.0.0",
  "private": true,
  "engines": { "node": ">=22.18.0" },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "powershell -NoProfile -Command \"if (Test-Path .next-dev) { Remove-Item -LiteralPath .next-dev -Recurse -Force }\"; pnpm exec next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib pages",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "@mcpcn/mcp-book-info": "^1.0.5",
    "lucide-react": "^0.468.0",
    "mcp-open-library": "^1.2.2",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.24",
    "typescript": "^5.5.4"
  }
}
